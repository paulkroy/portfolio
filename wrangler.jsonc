{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paul-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Cloudflare creates the DNS record and certificate for a custom domain on deploy.
  "routes": [{ "pattern": "paulkroy.tech", "custom_domain": true }],
  // Keep the workers.dev URL working too.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only API routes hit the Worker; everything else is served straight from the asset cache.
    // `/__scheduled` is wrangler dev's cron test hook (`--test-scheduled`); in production it falls through to a 404.
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paul-portfolio-status",
      "database_id": "e8a9fa38-b6fb-44eb-9a41-89bd6b98a64d",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI runs the open-weight chat model behind /api/chat.
  "ai": { "binding": "AI" },
  // Chat limits. Per visitor (keyed by IP) and site-wide, so a crowd of IPs can't run up the bill.
  "ratelimits": [
    { "name": "CHAT_LIMIT_IP", "namespace_id": "7101", "simple": { "limit": 10, "period": 60 } },
    { "name": "CHAT_LIMIT_SITE", "namespace_id": "7102", "simple": { "limit": 60, "period": 60 } }
  ],
  "triggers": {
    // Check every client site every 5 minutes.
    "crons": ["*/5 * * * *"]
  },
  "observability": { "enabled": true }
}
