---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

// Photos live in src/assets/about/ so Astro can resize them to WebP.
// TODO: swap the placeholders for real imports, e.g. `import portrait from '../assets/about/portrait.jpg'`
const portrait: ImageMetadata | undefined = undefined;

const facts = [
  ['Based in', site.location],
  ['Currently', 'Web developer at Melbourne Web Studio'],
  ['Focus', 'Local business sites, SEO'],
];

const hobbies: { src?: ImageMetadata; alt: string; caption: string }[] = [
  { alt: '', caption: 'Hobby one' },
  { alt: '', caption: 'Hobby two' },
  { alt: '', caption: 'Hobby three' },
];
---

<Base title="About" description="Paul Roy is a web developer at Melbourne Web Studio in Preston, building fast local websites for Melbourne businesses.">
  <section class="container section">
    <p class="eyebrow">About</p>
    <div class="about">
      <div class="aside">
        <div class="portrait">
          {portrait ? (
            <Image src={portrait} alt={site.name} widths={[320, 480, 640]} quality={90} sizes="320px" loading="eager" />
          ) : (
            <span class="placeholder mono" aria-hidden="true">PR</span>
          )}
        </div>
        <dl class="facts mono">
          {facts.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="copy">
        <h1>I'm Paul, a web developer at Melbourne Web Studio in Preston.</h1>
        <p>
          I take client sites from first conversation to launch: design, build, SEO and the maintenance that keeps them
          running. Most of my clients are local trades and service businesses, so a site has to load fast, rank in local
          search and make it easy to get a quote.
        </p>
        <p>
          I also build outside the page-builder world. JM Berry Farms is hand-built in Astro with three.js, and this
          portfolio is too, running on Cloudflare Workers.
        </p>
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <h2>Outside work</h2>
    </div>
    <ul class="hobbies">
      {hobbies.map(({ src, alt, caption }) => (
        <li>
          <figure>
            <div class="photo">
              {src ? (
                <Image src={src} alt={alt} widths={[400, 600, 800]} quality={85} sizes="(max-width: 759px) 100vw, 440px" />
              ) : (
                <span class="placeholder mono" aria-hidden="true">Photo</span>
              )}
            </div>
            <figcaption class="mono">{caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .about {
    display: grid;
    gap: 3rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 1119px) {
    .about { grid-template-columns: 0.85fr 1.15fr; gap: 4rem; }
  }

  /* Portrait: 4:5 frame with a soft accent glow that brightens on hover */
  .portrait {
    position: relative;
    max-width: 320px;
    aspect-ratio: 4 / 5;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .portrait::before {
    content: '';
    position: absolute;
    inset: -0.6rem;
    z-index: -1;
    border-radius: 1.5rem;
    background: linear-gradient(
      to top right,
      color-mix(in srgb, var(--accent) 45%, transparent),
      color-mix(in srgb, var(--accent) 20%, transparent),
      color-mix(in srgb, var(--accent) 5%, transparent)
    );
    filter: blur(40px);
    opacity: 0.8;
    transition: opacity 0.5s var(--ease);
  }
  .portrait:hover::before { opacity: 1; }
  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }

  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .facts {
    max-width: 320px;
    margin-top: 2rem;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
  }
  .facts div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .facts dd { text-align: right; }

  h1 { font-size: var(--step-2); margin-bottom: 1.25rem; max-width: 26ch; }
  .copy p { color: var(--muted); max-width: 60ch; margin-bottom: 1rem; }

  .hobbies {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    padding: 0;
    list-style: none;
  }
  @media (max-width: 759px) {
    .hobbies { grid-template-columns: minmax(0, 1fr); }
  }
  .photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .hobbies li:hover .photo :global(img) { transform: scale(1.03); }
  figcaption {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
