---
import Base from '../layouts/Base.astro';
---

<Base title="About" description="Paul Roy is a web developer at Melbourne Web Studio in Preston, building fast local websites for Melbourne businesses.">
  <section class="container section about">
    <p class="eyebrow">About</p>
    <div>
      <h1>I'm Paul, a web developer at Melbourne Web Studio in Preston.</h1>
      <p>
        I take client sites from first conversation to launch: design, build, SEO and the maintenance that keeps them
        running. Most of my clients are local trades and service businesses, so a site has to load fast, rank in local
        search and make it easy to get a quote.
      </p>
      <p>
        I also build outside the page-builder world. JM Berry Farms is hand-built in Astro with three.js, and this
        portfolio is too, running on Cloudflare Workers.
      </p>
    </div>
  </section>
</Base>

<style>
  .about { display: grid; gap: 1.5rem; }
  @media (min-width: 900px) {
    .about { grid-template-columns: 1fr 2.5fr; }
  }
  h1 { font-size: var(--step-2); margin-bottom: 1.25rem; max-width: 26ch; }
  .about p:not(.eyebrow) { color: var(--muted); max-width: 60ch; margin-bottom: 1rem; }
</style>
