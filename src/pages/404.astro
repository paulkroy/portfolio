---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="container section lost">
    <p class="eyebrow">404 · Off the map</p>
    <h1>This page doesn't exist.</h1>
    <p class="muted">It may have moved, or the link might be wrong.</p>
    <a class="btn btn--primary" href="/">Back to home</a>
  </section>
</Base>

<style>
  .lost { display: grid; gap: 1rem; justify-items: start; min-height: 60vh; align-content: center; }
  h1 { font-size: var(--step-4); }
</style>
