---
import Base from '../layouts/Base.astro';
import MapStatic from '../components/MapStatic.astro';
import MapLive, { type Pin } from '../components/MapLive';
import ProjectCard from '../components/ProjectCard.astro';
import LayoutToggle from '../components/LayoutToggle.astro';
import StatusBoard from '../components/StatusBoard.svelte';
import { getProjects } from '../lib/projects';
import { site } from '../data/site';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const pins: Pin[] = projects
  .filter((p) => p.data.location !== 'Online store')
  .map((p) => ({ slug: p.id, name: p.data.name, industry: p.data.industry, location: p.data.location, coords: p.data.coords }));
const suburbs = new Set(projects.map((p) => p.data.location).filter((l) => l !== 'Online store'));
---

<Base>
  <section class="hero container">
    <div class="intro anim-page-in" data-xray="fluid-type">
      <p class="eyebrow">{site.role} · {site.location}</p>
      <h1>I design and build websites for Melbourne businesses.</h1>
      <p class="lede">
        Ten of them are live right now, from a family-law firm to a Yarra Valley strawberry farm. I use WordPress and
        Bricks for clients who need to edit their own site, and Astro, TypeScript and Cloudflare when the job calls for code.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href="/work">See the work</a>
        <a class="btn" href={`mailto:${site.email}`}>Email me</a>
      </div>
      <dl class="stats" data-xray="stats">
        <div><dt>Live client sites</dt><dd>{projects.length}</dd></div>
        <div><dt>Suburbs on the map</dt><dd>{suburbs.size}</dd></div>
        <div><dt>Industries</dt><dd>{new Set(projects.map((p) => p.data.industry)).size}</dd></div>
      </dl>
    </div>
    <MapStatic projects={projects}>
      <MapLive client:visible pins={pins} />
    </MapStatic>
  </section>

  <section class="section container">
    <div class="section-head">
      <h2>Selected work</h2>
      <p>Real businesses with real customers. Every project links to the live site, so you can see it working.</p>
    </div>
    <div class="grid-tools">
      <LayoutToggle target="featured-grid" />
    </div>
    <div class="project-grid" id="featured-grid">
      {featured.map((project, i) => <ProjectCard project={project} xray={i === 0 ? 'screenshots' : undefined} />)}
    </div>
    <div class="all-work">
      <a class="btn" href="/work">All client work</a>
    </div>
  </section>

  <section id="status" class="section container">
    <div class="section-head">
      <h2>Live status</h2>
      <p>
        I don't just launch sites, I keep them running. A Cloudflare Worker checks every one of them every 5 minutes.
        <a href="/status">How it works →</a>
      </p>
    </div>
    <div data-xray="status-board">
      <StatusBoard client:visible compact />
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: center;
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4.5rem) var(--section);
  }
  @media (min-width: 960px) {
    .hero { grid-template-columns: 1.05fr 1fr; }
  }
  .intro { display: grid; gap: 1.5rem; justify-items: start; }
  h1 { font-size: var(--step-4); }
  .lede { font-size: var(--step-1); line-height: 1.5; color: var(--muted); max-width: 40ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem clamp(1.25rem, 0.5rem + 3vw, 2.5rem);
    margin-top: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .stats div { display: flex; flex-direction: column-reverse; }
  .stats dt { font-size: var(--step--1); color: var(--muted); }
  .stats dd { font-size: var(--step-3); font-weight: 600; line-height: 1; letter-spacing: -0.03em; }

  .grid-tools { display: flex; justify-content: flex-end; margin-bottom: 1.5rem; }

  .all-work { margin-top: var(--section); }
</style>
