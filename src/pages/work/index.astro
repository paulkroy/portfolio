---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, hostname } from '../../lib/projects';

const projects = await getProjects();
// Every project gets a card, featured ones first
const ordered = [...projects.filter((p) => p.data.featured), ...projects.filter((p) => !p.data.featured)];
---

<Base title="Work" description="Live client websites Paul Roy has designed and built for Melbourne businesses.">
  <section class="container section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Work</p>
        <h1>Client work</h1>
      </div>
      <p>Real businesses with real customers. Every project links to the live site, so you can see it working.</p>
    </div>
    <div class="grid">
      {ordered.map((project, i) => <ProjectCard project={project} xray={i === 0 ? 'screenshots' : undefined} />)}
    </div>
  </section>
</Base>

<style>
  h1 { font-size: var(--step-3); margin-top: 0.5rem; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 460px), 1fr));
    gap: clamp(2.5rem, 2rem + 2vw, 4rem) clamp(1.5rem, 1rem + 2vw, 3rem);
  }
</style>
