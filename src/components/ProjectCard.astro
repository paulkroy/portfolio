---
import { Image } from 'astro:assets';
import { getShot, hostname, type Project } from '../lib/projects';

interface Props {
  project: Project;
  /** X-ray annotation id to attach to this card. */
  xray?: string;
}

const { project, xray } = Astro.props;
const { name, url, industry, location, summary, stack } = project.data;
const shot = getShot(project.id, 'desktop');
---

<article class="card" data-xray={xray}>
  <a href={`/work/${project.id}`} class="frame" tabindex="-1" aria-hidden="true">
    <div class="chrome"><span></span><span></span><span></span><em class="mono">{hostname(url)}</em></div>
    {shot ? (
      <Image src={shot} alt="" widths={[480, 720, 960]} sizes="(max-width: 800px) 100vw, 560px" />
    ) : (
      <div class="placeholder mono">{hostname(url)}</div>
    )}
  </a>
  <div class="body">
    <p class="eyebrow">{industry} · {location}</p>
    <h3><a href={`/work/${project.id}`}>{name}</a></h3>
    <p class="summary">{summary}</p>
    <ul class="chips" aria-label="Built with">
      {stack.map((s) => <li>{s}</li>)}
    </ul>
    <a class="visit" href={url} target="_blank" rel="noopener">
      Visit {hostname(url)} <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>

<style>
  .card {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .frame {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    transition: transform 0.35s var(--ease), border-color 0.35s var(--ease);
  }
  .card:hover .frame { transform: translateY(-4px); border-color: var(--muted); }
  .chrome {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  .chrome span { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--line); }
  .chrome em { margin-left: 0.5rem; font-size: 0.7rem; font-style: normal; color: var(--muted); }
  .frame img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
  .placeholder { display: grid; place-items: center; aspect-ratio: 16 / 10; color: var(--muted); }

  .body { display: grid; gap: 0.6rem; justify-items: start; }
  h3 { font-size: var(--step-2); }
  h3 a { text-decoration: none; }
  h3 a::after { content: ' →'; opacity: 0; transition: opacity 0.2s; }
  h3 a:hover::after,
  h3 a:focus-visible::after { opacity: 1; }
  .summary { color: var(--muted); max-width: 52ch; }
  .visit { font-size: var(--step--1); color: var(--muted); }
  .visit:hover { color: var(--accent); }
</style>
