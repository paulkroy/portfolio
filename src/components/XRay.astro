---
// X-ray mode: a toggle that outlines annotated parts of the page and explains
// how each one is built. Plain TypeScript and the native Popover API, with code
// highlighted at build time by Shiki and shipped as inert <template>s.
import { Code } from 'astro:components';
import { annotations } from '../data/xray';
---

<button type="button" class="xray-toggle" data-xray-toggle aria-pressed="false" title="Show how this site is built (X)">
  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
    <rect x="1.5" y="1.5" width="13" height="13" rx="2" fill="none" stroke="currentColor" stroke-dasharray="2 2" />
    <path d="M5 5l6 6M11 5l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  </svg>
  <span>X-ray</span>
</button>

<div id="xray-panel" popover aria-labelledby="xray-panel-title">
  <div class="xray-panel__head">
    <p class="xray-panel__eyebrow">How it's built</p>
    <button type="button" class="xray-panel__close" popovertarget="xray-panel" popovertargetaction="hide" aria-label="Close">×</button>
  </div>
  <div class="xray-panel__body"></div>
</div>

{Object.entries(annotations).map(([id, a]) => (
  <template id={`xray-tpl-${id}`} data-title={a.title}>
    <h2 id="xray-panel-title" class="xray-panel__title">{a.title}</h2>
    {a.body.map((p) => <p>{p}</p>)}
    <div class="xray-code">
      <p class="xray-code__file">{a.file}</p>
      <Code code={a.code} lang={a.lang} theme="github-dark-dimmed" />
    </div>
  </template>
))}

<script>
  const STORAGE_KEY = 'xray';
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-xray-toggle]')!;
  const panel = document.getElementById('xray-panel')!;
  const panelBody = panel.querySelector('.xray-panel__body')!;

  const enabled = () => root.hasAttribute('data-xray-on');

  // The panel is a popover, so re-show the cursor layer to keep it on top
  const cursorLayer = document.querySelector<HTMLElement>('.cursor-layer');
  function raiseCursor() {
    if (cursorLayer?.matches(':popover-open')) {
      cursorLayer.hidePopover();
      cursorLayer.showPopover();
    }
  }

  function open(id: string) {
    const tpl = document.getElementById(`xray-tpl-${id}`) as HTMLTemplateElement | null;
    if (!tpl) return;
    panelBody.replaceChildren(tpl.content.cloneNode(true));
    if (!panel.matches(':popover-open')) {
      panel.showPopover();
      raiseCursor();
    }
    panel.scrollTop = 0;
    panel.querySelector<HTMLElement>('.xray-panel__close')?.focus();
  }

  function addTags() {
    document.querySelectorAll<HTMLElement>('[data-xray]').forEach((el) => {
      if (el.querySelector(':scope > .xray-tags')) return;
      const tags = document.createElement('div');
      tags.className = 'xray-tags';
      // Elements that clip their overflow get their tags inside the outline.
      if (getComputedStyle(el).overflow !== 'visible') tags.classList.add('xray-tags--inside');
      // Elements at the very top of the page get their tags below instead.
      else if (el.getBoundingClientRect().top + scrollY < 48) tags.classList.add('xray-tags--below');
      for (const id of el.dataset.xray!.split(/\s+/)) {
        const tpl = document.getElementById(`xray-tpl-${id}`);
        if (!tpl) continue;
        const tag = document.createElement('button');
        tag.type = 'button';
        tag.className = 'xray-tag';
        tag.textContent = tpl.dataset.title ?? id;
        tag.setAttribute('aria-haspopup', 'dialog');
        tag.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          open(id);
        });
        tags.append(tag);
      }
      el.prepend(tags);
    });
  }

  function setEnabled(on: boolean) {
    root.toggleAttribute('data-xray-on', on);
    toggle.setAttribute('aria-pressed', String(on));
    try {
      on ? localStorage.setItem(STORAGE_KEY, '1') : localStorage.removeItem(STORAGE_KEY);
    } catch {}
    if (on) {
      addTags();
    } else {
      document.querySelectorAll('.xray-tags').forEach((t) => t.remove());
      if (panel.matches(':popover-open')) panel.hidePopover();
    }
  }

  const isTyping = (e: KeyboardEvent) =>
    e.target instanceof HTMLElement && (e.target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName));

  toggle.addEventListener('click', () => setEnabled(!enabled()));
  document.addEventListener('keydown', (e) => {
    if (e.key.toLowerCase() === 'x' && !e.metaKey && !e.ctrlKey && !e.altKey && !isTyping(e)) setEnabled(!enabled());
  });

  // Shareable: /?xray opens the page with annotations on.
  const fromUrl = new URLSearchParams(location.search).has('xray');
  let stored = false;
  try {
    stored = localStorage.getItem(STORAGE_KEY) === '1';
  } catch {}
  if (fromUrl || stored) setEnabled(true);
</script>

<style>
  .xray-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.7rem;
    border: 1px dashed var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: 500 0.75rem var(--font-mono);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background-color 0.2s;
  }
  .xray-toggle:hover { color: var(--text); border-color: var(--muted); }
  .xray-toggle[aria-pressed='true'] {
    color: var(--xray);
    border-color: var(--xray);
    background: color-mix(in oklab, var(--xray) 12%, transparent);
  }
</style>

<style is:global>
  html[data-xray-on] body {
    background-image:
      linear-gradient(color-mix(in oklab, var(--xray) 6%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklab, var(--xray) 6%, transparent) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  html[data-xray-on] [data-xray] {
    position: relative;
    outline: 1px dashed var(--xray);
    outline-offset: 6px;
  }

  .xray-tags {
    position: absolute;
    z-index: 30;
    top: -6px;
    left: -6px;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    transform: translateY(-100%);
  }
  .xray-tags--inside { top: 0.6rem; left: 0.6rem; transform: none; }
  .xray-tags--below { top: calc(100% + 10px); transform: none; }
  .xray-tag {
    padding: 0.15rem 0.5rem;
    border: 0;
    border-radius: 4px;
    background: var(--xray);
    color: #00131c;
    font: 500 0.7rem/1.4 var(--font-mono);
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
    cursor: pointer;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.25);
  }
  :global([data-theme='light']) .xray-tag { color: #fff; }
  .xray-tag:hover { filter: brightness(1.1); }
  .xray-tag:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; }

  #xray-panel {
    position: fixed;
    inset: auto 1rem 1rem auto;
    width: min(480px, calc(100vw - 2rem));
    max-height: min(75vh, 680px);
    margin: 0;
    padding: 1.25rem 1.4rem 1.4rem;
    overflow: auto;
    border: 1px solid var(--xray);
    border-radius: calc(var(--radius) * 1.4);
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.45);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  #xray-panel::backdrop { background: transparent; }
  .xray-panel__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; }
  .xray-panel__eyebrow { font: 500 0.7rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.05em; color: var(--xray); }
  .xray-panel__close {
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }
  .xray-panel__close:hover { color: var(--text); border-color: var(--muted); }
  .xray-panel__title { margin-bottom: 0.75rem; font-size: 1.25rem; }
  .xray-panel__body > p { margin-bottom: 0.75rem; color: var(--muted); }

  .xray-code { margin-top: 1rem; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .xray-code__file {
    padding: 0.45rem 0.8rem;
    border-bottom: 1px solid var(--line);
    font: 0.72rem var(--font-mono);
    color: var(--muted);
  }
  .xray-code pre {
    margin: 0;
    padding: 0.8rem;
    overflow-x: auto;
    font: 0.78rem/1.55 var(--font-mono);
    background: var(--surface-2) !important;
  }

  @media (prefers-reduced-motion: no-preference) {
    #xray-panel:popover-open { animation: xray-in 0.22s var(--ease); }
    @keyframes xray-in { from { opacity: 0; transform: translateY(8px); } }
  }
</style>
