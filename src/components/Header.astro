---
import { site } from '../data/site';
import XRay from './XRay.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/work', label: 'Work' },
  { href: '/status', label: 'Status' },
  { href: '/toolkit', label: 'Toolkit' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container bar" data-xray="header xray-toggle">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>
      <span class="dot" aria-hidden="true"></span>
      <span>{site.name}</span>
      <span class="coords mono" aria-hidden="true">37.81°S 144.96°E</span>
    </a>
    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <svg class="icon-open" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
        <path d="M2.5 5h11M2.5 8h11M2.5 11h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <svg class="icon-close" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
        <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <ThemeToggle />
    <XRay />
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const button = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const nav = header.querySelector<HTMLElement>('#site-nav')!;

  function setOpen(open: boolean) {
    header.toggleAttribute('data-open', open);
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  button.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
  // Picking a link closes the menu, so the next page starts closed
  nav.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !header.hasAttribute('data-open')) return;
    // The nav hides on close, so move focus back to the toggle if it was inside the menu
    const focusWasInNav = nav.contains(document.activeElement);
    setOpen(false);
    if (focusWasInNav) button.focus();
  });
  // Back on a wide screen the inline nav is shown, so drop the open panel
  matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    text-decoration: none;
  }
  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--tertiary);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--tertiary) 25%, transparent);
  }
  .coords {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--muted);
  }
  nav { margin-left: auto; }
  nav ul {
    display: flex;
    gap: clamp(0.75rem, 0.4rem + 1.5vw, 1.75rem);
    padding: 0;
    list-style: none;
  }
  nav a {
    font-size: var(--step--1);
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  nav a:hover { color: var(--text); }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    margin-left: auto;
    border: 1px dashed var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .menu-toggle:hover { color: var(--text); border-color: var(--muted); }
  .menu-toggle svg { grid-area: 1 / 1; }
  .menu-toggle .icon-close { display: none; }
  .site-header[data-open] .menu-toggle .icon-open { display: none; }
  .site-header[data-open] .menu-toggle .icon-close { display: block; }

  /* Below tablet and landscape-phone widths the links move into a panel under the bar */
  @media (max-width: 767px) {
    .menu-toggle { display: inline-grid; }
    nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }
    .site-header[data-open] nav { display: block; }
    nav ul { flex-direction: column; gap: 0; padding-block: 0.5rem; }
    nav a {
      display: block;
      padding: 0.9rem var(--space);
      font-size: var(--step-0);
      color: var(--text);
    }
  }
  @media (max-width: 640px) {
    .coords { display: none; }
    .bar :global(.xray-toggle span) { display: none; }
  }
</style>
